# Let git normalise text, but keep CRLF for the files Windows tooling insists on.
* text=auto

*.vb      text eol=crlf
*.vbproj  text eol=crlf
*.sln     text eol=crlf
*.wxs     text eol=crlf
*.cmd     text eol=crlf
*.config  text eol=crlf

*.md      text eol=lf

# HTML Help Workshop sources, kept in the line endings Workshop itself writes.
*.hhp     text eol=crlf
*.hhc     text eol=crlf
*.hhk     text eol=crlf
*.htm     text eol=crlf
*.css     text eol=crlf

*.ico  binary
*.png  binary
*.jpg  binary
*.mdb  binary
*.msi  binary
*.chm  binary
*.xlsx binary
*.pptx binary
